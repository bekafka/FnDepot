#!/usr/bin/env python3
"""Git 凭据助手：GitHub token 从 tools/_gh.py 实时取，不写进 .git/config、不写 .git-credentials。

git 会以 `git-credential-fndepot get|store|erase` 形式调用它：
  get   → 输出 username / password（token 绝不落盘）
  store / erase → 什么都不做
取不到 token 时静默退出 0，让 git 继续尝试其它助手或提示输入，避免卡死别人的推送流程。
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _gh import gh_token  # noqa: E402


def main():
    op = sys.argv[1] if len(sys.argv) > 1 else "get"
    fields = {}
    for line in sys.stdin:
        line = line.strip()
        if not line:
            break
        key, _, value = line.partition("=")
        fields[key] = value

    if op != "get":
        return 0
    if fields.get("host") != "github.com":
        return 0
    token = gh_token()
    if not token:
        return 0
    print("username=" + os.environ.get("FNDEPOT_GIT_USER", "bekafka"))
    print("password=" + token)
    return 0


if __name__ == "__main__":
    sys.exit(main())
