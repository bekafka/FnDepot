#!/bin/bash
# ==============================================================================
# 卸载后：撤掉本应用建立的命令入口、还原被接管的同名命令、按选择处理状态目录。
#
# 不调 payload 里的 gh-link.sh：卸载回调执行时应用目录可能已被清掉，
# 所以清理逻辑自带（记录格式与 gh-link.sh 一致）。
#
# 路径护栏：只删「指向本应用」的链接；记录只在 /vol1/@appdata/* 下才动。
# ==============================================================================
set -u

APPNAME="gh"
PKGVAR="${TRIM_PKGVAR:-}"
LINK="/usr/local/bin/gh"
RECORD="${PKGVAR:+$PKGVAR/preserved-usr-local-bin-gh}"
MODE="${wizard_uninstall_mode:-keep}"

log() {
  printf '%s - [uninstall] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" \
    >> "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true
  echo "[uninstall] $1"
}

# ── 1. 移除本应用建立的命令入口 ─────────────────────────────────────────────
if [ -L "$LINK" ]; then
  TARGET="$(readlink "$LINK" 2>/dev/null || true)"
  case "$TARGET" in
    /var/apps/$APPNAME/*|/vol1/@appcenter/$APPNAME/*)
      rm -f "$LINK" 2>/dev/null && log "已移除命令入口 $LINK（原指向 $TARGET）"
      ;;
    *)
      log "$LINK 指向别处（$TARGET），不属于本应用，不动它"
      ;;
  esac
elif [ -e "$LINK" ]; then
  log "$LINK 是真实文件，不属于本应用，不动它"
else
  log "$LINK 不存在，无需移除"
fi

# ── 2. 还原安装时被接管的同名命令 ───────────────────────────────────────────
if [ -n "$RECORD" ] && [ -s "$RECORD" ]; then
  PREV="$(head -n 1 "$RECORD" | tr -d '\r\n' | sed 's/[[:space:]]*$//')"
  if [ -n "$PREV" ] && { [ -e "$PREV" ] || [ -L "$PREV" ]; }; then
    if [ ! -e "$LINK" ] && [ ! -L "$LINK" ]; then
      ln -sfn "$PREV" "$LINK" 2>/dev/null && log "已还原被接管的命令入口：$LINK → $PREV"
    else
      log "还原跳过：$LINK 已被别的东西占用（记录的原指向是 $PREV）"
    fi
  else
    log "安装时接管的原命令已不存在（${PREV:-空}），不做还原以免留下悬空链接"
  fi
else
  log "没有接管记录（安装时 /usr/local/bin/gh 本来就不存在），无需还原"
fi

# ── 3. 按用户选择处理应用状态目录（含 token）────────────────────────────────
case "$MODE" in
  purge)
    case "$PKGVAR" in
      /vol1/@appdata/*)
        log "完全卸载：删除 GitHub Token、接管记录与安装日志"
        rm -f "$PKGVAR/github-token" \
              "$PKGVAR/preserved-usr-local-bin-gh" \
              "$PKGVAR/preserved-usr-local-bin-gh.bin" \
              "$PKGVAR/info.log.1" 2>/dev/null || true
        log "残留内容：$(ls -A "$PKGVAR" 2>/dev/null | tr '\n' ' ')"
        rm -f "$PKGVAR/info.log" 2>/dev/null || true
        ;;
      *)
        log "PKGVAR 不在预期路径（${PKGVAR:-空}），为安全起见跳过删除"
        ;;
    esac
    ;;
  *)
    log "保留记录卸载：GitHub Token 与日志都留着，重装后可直接沿用"
    ;;
esac

log "提示：你自己的仓库目录、~/.config/gh 下的个人登录态都未改动"
exit 0
