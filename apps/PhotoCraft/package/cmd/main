#!/bin/bash
# ==============================================================================
# PhotoCraft · 生命周期入口（start / stop / status / bootstrap）
#
# 本应用只有一个常驻进程：包内的静态站点服务 photocraft-web，只监听端口、不写盘。
#
# 加固要点（对应 FnFactory specs/lifecycle.md，都是飞牛上实测踩过的坑）：
#   · pid 身份校验：/proc/<pid>/exe 两侧 readlink -f 后比对，避免 TRIM_APPDEST 是软链时
#     把「在跑」误判成「没在跑」，或把复用 pid 的别的进程当成自己。
#   · 孤儿清扫只遍历 /proc 比 exe，不用 pgrep（飞牛上进程 comm 会被改写）。
#   · 端口/监听一律从 config.env 现读，用户可能改过。
#   · 就绪判据是应用自己的 /healthz，不是「端口已监听」。
#   · 启动失败要回收自己拉起的进程，不留「显示 stopped 但端口还被占着」的半状态。
# ==============================================================================
set -u

APPNAME="PhotoCraft"
PKGVAR="${TRIM_PKGVAR:-/var/apps/$APPNAME/var}"
APPDEST="${TRIM_APPDEST:-/var/apps/$APPNAME/target}"
BIN="$APPDEST/bin/photocraft-web"
WEBROOT="$APPDEST/webroot"
LOG_FILE="$PKGVAR/info.log"
PID_FILE="$PKGVAR/app.pid"
CONF="$PKGVAR/config.env"

DEFAULT_PORT=28200
DEFAULT_LISTEN="0.0.0.0"
READY_TIMEOUT=30
LOG_MAX_BYTES=5242880

mkdir -p "$PKGVAR" "$PKGVAR/home" 2>/dev/null || true

log_msg() {
  printf '%s - %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG_FILE" 2>/dev/null || true
}
resolve_path() { readlink -f "$1" 2>/dev/null || printf '%s' "$1"; }
check_process() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }

load_config() {
  PHOTOCRAFT_PORT="$DEFAULT_PORT"
  PHOTOCRAFT_LISTEN="$DEFAULT_LISTEN"
  if [ -r "$CONF" ]; then
    # shellcheck disable=SC1090
    . "$CONF"
  else
    log_msg "缺少 $CONF（install_callback 没跑？），使用内置默认值"
  fi
  case "${PHOTOCRAFT_PORT:-}" in ''|*[!0-9]*) PHOTOCRAFT_PORT="$DEFAULT_PORT" ;; esac
  [ "$PHOTOCRAFT_PORT" -ge 1 ] 2>/dev/null && [ "$PHOTOCRAFT_PORT" -le 65535 ] 2>/dev/null \
    || PHOTOCRAFT_PORT="$DEFAULT_PORT"
  [ -n "${PHOTOCRAFT_LISTEN:-}" ] || PHOTOCRAFT_LISTEN="$DEFAULT_LISTEN"
}

port_in_use() { ss -ltn 2>/dev/null | grep -qE "[:.]$1[[:space:]]"; }
port_owner() {
  ss -ltnp 2>/dev/null | grep -E "[:.]$1[[:space:]]" | sed -n 's/.*users:((\(.*\))).*/\1/p' | head -n 1
}
http_code() { curl -s -o /dev/null -m 2 -w '%{http_code}' "$1" 2>/dev/null || true; }
health_code() { http_code "http://127.0.0.1:$PHOTOCRAFT_PORT/healthz"; }

rotate_logs() {
  local size
  [ -f "$LOG_FILE" ] || return 0
  size="$(stat -c%s "$LOG_FILE" 2>/dev/null || echo 0)"
  [ "${size:-0}" -le "$LOG_MAX_BYTES" ] && return 0
  mv -f "$LOG_FILE" "$LOG_FILE.1" 2>/dev/null || : > "$LOG_FILE"
  : > "$LOG_FILE"
  chmod 0644 "$LOG_FILE" 2>/dev/null || true
  log_msg "日志已轮转（> ${LOG_MAX_BYTES} 字节），上一份保留为 info.log.1"
}

# ── 进程身份 ────────────────────────────────────────────────────────────────
check_identity() {
  local pid="$1" exe want
  [ -r "/proc/$pid/exe" ] || return 1
  exe="$(resolve_path "$(readlink "/proc/$pid/exe" 2>/dev/null)")"
  want="$(resolve_path "$BIN")"
  [ -n "$exe" ] && [ "$exe" = "$want" ] || return 1
}

find_orphans() {
  local pid exe want
  want="$(resolve_path "$BIN")"
  for pid in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
    [ "$pid" = "$$" ] && continue
    [ -r "/proc/$pid/exe" ] || continue
    exe="$(resolve_path "$(readlink "/proc/$pid/exe" 2>/dev/null)")"
    [ "$exe" = "$want" ] && printf '%s\n' "$pid"
  done
}

wait_ready() {
  local pid="$1" waited=0 code
  while [ "$waited" -lt "$READY_TIMEOUT" ]; do
    if ! check_process "$pid"; then
      log_msg "进程在启动窗口内退出（见 $LOG_FILE）"
      return 1
    fi
    code="$(health_code)"
    if [ "$code" = "200" ]; then
      log_msg "就绪（${waited}s）：http://$PHOTOCRAFT_LISTEN:$PHOTOCRAFT_PORT/（/healthz 200）"
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  log_msg "等待 ${READY_TIMEOUT}s 仍未就绪（/healthz ${code:-000}）"
  return 1
}

start_process() {
  local pid owner
  if [ -r "$PID_FILE" ]; then
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if check_process "$pid" && check_identity "$pid"; then
      log_msg "已在运行（pid=$pid），跳过启动"
      return 0
    fi
    rm -f "$PID_FILE"
  fi

  load_config
  rotate_logs

  [ -x "$BIN" ] || { log_msg "找不到可执行文件 $BIN（payload 缺失？）"; return 1; }
  [ -f "$WEBROOT/index.html" ] || { log_msg "站点目录缺少 index.html：$WEBROOT（payload 没铺好？）"; return 1; }

  if port_in_use "$PHOTOCRAFT_PORT"; then
    owner="$(port_owner "$PHOTOCRAFT_PORT")"
    log_msg "警告：端口 $PHOTOCRAFT_PORT 已被占用（${owner:-未知}），若启动失败请改端口或先停掉占用者"
  fi

  log_msg "启动：photocraft-web -listen $PHOTOCRAFT_LISTEN:$PHOTOCRAFT_PORT -root $WEBROOT"
  # HOME 指到 PKGVAR：任何 ~ 展开都不会跑出应用目录。服务本身不写盘。
  ( cd "$PKGVAR" && HOME="$PKGVAR/home" \
      "$BIN" -listen "$PHOTOCRAFT_LISTEN:$PHOTOCRAFT_PORT" -root "$WEBROOT" ) \
    >> "$LOG_FILE" 2>&1 &
  pid=$!
  printf '%s' "$pid" > "$PID_FILE"

  if wait_ready "$pid"; then
    return 0
  fi

  log_msg "启动失败，回收本次拉起的进程"
  kill -TERM "$pid" 2>/dev/null
  sleep 2
  check_process "$pid" && kill -KILL "$pid" 2>/dev/null
  local opid
  for opid in $(find_orphans); do kill -TERM "$opid" 2>/dev/null; done
  rm -f "$PID_FILE"
  return 1
}

stop_process() {
  local pid waited=0 opid
  if [ -r "$PID_FILE" ]; then
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if check_process "$pid" && check_identity "$pid"; then
      log_msg "停止 pid=$pid"
      kill -TERM "$pid" 2>/dev/null
      while [ "$waited" -lt 15 ] && check_process "$pid"; do sleep 1; waited=$((waited + 1)); done
      if check_process "$pid"; then
        log_msg "SIGTERM 超时，SIGKILL pid=$pid"
        kill -KILL "$pid" 2>/dev/null
        sleep 1
      fi
    else
      log_msg "pid 文件指向的进程不存在或身份不符（pid=${pid:-空}），跳过"
    fi
    rm -f "$PID_FILE"
  fi

  for opid in $(find_orphans); do
    log_msg "清理孤儿进程 pid=$opid"
    kill -TERM "$opid" 2>/dev/null
  done
  sleep 1
  for opid in $(find_orphans); do
    log_msg "孤儿进程未退出，SIGKILL pid=$opid"
    kill -KILL "$opid" 2>/dev/null
  done
  return 0
}

status_process() {
  local pid
  if [ -r "$PID_FILE" ]; then
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if check_process "$pid" && check_identity "$pid"; then return 0; fi
  fi
  for pid in $(find_orphans); do return 0; done
  return 3
}

# 安装期预检：确认二进制、站点与配置目录就位即可，不起服务。
bootstrap_process() {
  load_config
  mkdir -p "$PKGVAR/home" "$PKGVAR/tmp" 2>/dev/null || true
  [ -x "$BIN" ] || { echo "找不到可执行文件 $BIN" >&2; log_msg "引导失败：找不到 $BIN"; return 1; }
  [ -f "$WEBROOT/index.html" ] || { echo "站点目录缺少 index.html：$WEBROOT" >&2; log_msg "引导失败：缺少 $WEBROOT/index.html"; return 1; }
  log_msg "安装期预检完成：端口 $PHOTOCRAFT_PORT，监听 $PHOTOCRAFT_LISTEN，站点 $WEBROOT"
  return 0
}

case "${1:-}" in
  start)     start_process ;;
  stop)      stop_process ;;
  status)    if status_process; then exit 0; else exit 3; fi ;;
  bootstrap) bootstrap_process ;;
  *)         echo "usage: $0 {start|stop|status|bootstrap}"; exit 1 ;;
esac
