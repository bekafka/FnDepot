#!/bin/bash
# 安装后：建运行目录、把向导值落成 config.env、同步桌面入口、做一次启动前预检。
set -u
APPNAME="PhotoCraft"
PKGVAR="${TRIM_PKGVAR:?}"
APPDEST="${TRIM_APPDEST:?}"
LOG="$PKGVAR/info.log"
TMPLOG="${TRIM_TEMP_LOGFILE:-}"

emit() {
  printf '%s - [install] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG" 2>/dev/null || true
  [ -n "$TMPLOG" ] && printf '[install] %s\n' "$*" >> "$TMPLOG" 2>/dev/null || true
  echo "[install] $*"
}

mkdir -p "$PKGVAR"/{home,tmp} || { emit "创建数据目录失败"; exit 1; }

if [ ! -x "$APPDEST/apply-config.sh" ]; then
  emit "缺少 $APPDEST/apply-config.sh，安装失败"
  exit 1
fi
if ! bash "$APPDEST/apply-config.sh" install; then
  emit "apply-config.sh 执行失败，安装失败（详见 $LOG）"
  exit 1
fi

PORT="$(sed -n 's/^PHOTOCRAFT_PORT=//p' "$PKGVAR/config.env" 2>/dev/null | tail -n 1)"
HOST="$(sed -n 's/^PHOTOCRAFT_LISTEN=//p' "$PKGVAR/config.env" 2>/dev/null | tail -n 1)"

CMD_DIR="$(dirname "$0")"
[ -f "$CMD_DIR/main" ] || CMD_DIR="/var/apps/$APPNAME/cmd"
if [ -f "$CMD_DIR/main" ]; then
  if ! bash "$CMD_DIR/main" bootstrap >> "$LOG" 2>&1; then
    emit "安装期预检未通过（不影响安装：首次启动会再试一次，详见 $LOG）"
  fi
fi

emit "安装完成：PhotoCraft Web 版 http://<NAS-IP>:${PORT:-28200}/（监听 ${HOST:-0.0.0.0}，端口在设置页可改）"
emit "说明：编辑器在你的浏览器里运行；打开/保存文件都在你本机，不经过 NAS 存储"
emit "建议：用局域网 https 入口可获得 WebGPU 加速；明文 http 会退化为 WebGL2（可用但较慢）"
exit 0
