[
  {
    "stepTitle": "Cloudflare 优选 · 设置",
    "items": [
      {
        "type": "text",
        "field": "wizard_port",
        "label": "服务端口（留空保持不变）",
        "initValue": "",
        "rules": [
          { "pattern": "^$|^[0-9]+$", "message": "端口必须是数字，留空表示不改" },
          { "pattern": "^$|^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$", "message": "端口范围 1-65535" }
        ]
      },
      {
        "type": "radio",
        "field": "wizard_host",
        "label": "监听范围",
        "initValue": "keep",
        "options": [
          { "label": "保持当前设置", "value": "keep" },
          { "label": "局域网可访问（0.0.0.0）", "value": "0.0.0.0" },
          { "label": "仅本机（127.0.0.1）", "value": "127.0.0.1" }
        ]
      },
      {
        "type": "radio",
        "field": "wizard_allow_write",
        "label": "写 hosts",
        "initValue": "keep",
        "options": [
          { "label": "保持当前设置", "value": "keep" },
          { "label": "允许写入系统 hosts", "value": "1" },
          { "label": "只预览（不改系统文件）", "value": "0" }
        ]
      },
      {
        "type": "tips",
        "helpText": "保存后如果端口、监听范围或写 hosts 开关有变化，正在运行的 Cloudflare 优选会重启一次。域名列表、探测参数这些属于工具自己的配置，请直接在面板里改，不在这里设置。"
      }
    ]
  }
]
