#!/bin/bash
# ==============================================================================
# CloudflareIP · 生命周期入口（start / stop / status）
#
# 加固要点（对应 FnFactory specs/lifecycle.md，都是飞牛上踩过的坑）：
#   · pid 身份校验：/proc/<pid>/exe 两侧 readlink -f 后比对，避免把复用 pid 的其他
#     进程当成自己的（TRIM_APPDEST 可能是软链，不归一化必然误判）。
#   · 孤儿清扫只遍历 /proc 比 exe，不用 pgrep（飞牛上进程 comm 会被改写）。
#   · 配置/状态/hosts 备份全部落在 $TRIM_PKGVAR（工作目录就是 PKGVAR）：
#     config/config.json、config/state.json、info.log 都跟着走，重装不丢。
#   · 本应用以 root 运行（写 /etc/hosts 必须），所以这里不做 setpriv 降权；
#     真正的写入门控在应用自己的 -write 开关上（见 apply-config.sh 的 CFIP_WRITE）。
#   · 就绪判据：首页 200。端口一律从 config.env 现读，不写死。
#   · 启动失败要收拾自己拉起的进程，不留「App Center 显示 stopped 但端口还占着」。
# ==============================================================================
set -u

APPNAME="CloudflareIP"
PKGVAR="${TRIM_PKGVAR:-/var/apps/$APPNAME/var}"
APPDEST="${TRIM_APPDEST:-/var/apps/$APPNAME/target}"
BIN="$APPDEST/bin/cloudflareip"

LOG_FILE="$PKGVAR/info.log"
PID_FILE="$PKGVAR/app.pid"
CONF="$PKGVAR/config.env"
CONFIG_DIR="$PKGVAR/config"
CONFIG_JSON="$CONFIG_DIR/config.json"

DEFAULT_PORT=26890
DEFAULT_LISTEN="0.0.0.0"
READY_TIMEOUT=30
LOG_MAX_BYTES=5242880

mkdir -p "$PKGVAR" "$CONFIG_DIR" 2>/dev/null || true

log_msg() {
  printf '%s - %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG_FILE" 2>/dev/null || true
}
resolve_path() { readlink -f "$1" 2>/dev/null || printf '%s' "$1"; }
check_process() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }

load_config() {
  CFIP_PORT="$DEFAULT_PORT"
  CFIP_LISTEN="$DEFAULT_LISTEN"
  CFIP_WRITE=1
  if [ -r "$CONF" ]; then
    # shellcheck disable=SC1090
    . "$CONF"
  else
    log_msg "缺少 $CONF（install_callback 没跑？），使用内置默认值"
  fi
  case "${CFIP_PORT:-}" in ''|*[!0-9]*) CFIP_PORT="$DEFAULT_PORT" ;; esac
  [ -n "${CFIP_LISTEN:-}" ] || CFIP_LISTEN="$DEFAULT_LISTEN"
  case "${CFIP_WRITE:-}" in 0|1) ;; *) CFIP_WRITE=1 ;; esac
}

port_in_use() { ss -ltn 2>/dev/null | grep -qE "[:.]$1[[:space:]]"; }
port_owner() {
  ss -ltnp 2>/dev/null | grep -E "[:.]$1[[:space:]]" | sed -n 's/.*users:((\(.*\))).*/\1/p' | head -n 1
}

http_code() { curl -s -o /dev/null -m 2 -w '%{http_code}' "$1" 2>/dev/null || true; }
page_code() { http_code "http://127.0.0.1:$CFIP_PORT/"; }

rotate_logs() {
  local size
  [ -f "$LOG_FILE" ] || return 0
  size="$(stat -c%s "$LOG_FILE" 2>/dev/null || echo 0)"
  [ "${size:-0}" -le "$LOG_MAX_BYTES" ] && return 0
  mv -f "$LOG_FILE" "$LOG_FILE.1" 2>/dev/null || : > "$LOG_FILE"
  : > "$LOG_FILE"
  chmod 0644 "$LOG_FILE" 2>/dev/null || true
  log_msg "日志已轮转（> ${LOG_MAX_BYTES} 字节），上一份保留为 info.log.1"
}

# config.json 由工具自己维护（域名列表、探测参数都在里面）；这里只确保目录可写。
ensure_config_json() {
  mkdir -p "$CONFIG_DIR" 2>/dev/null || return 1
  [ -s "$CONFIG_JSON" ] || log_msg "配置目录已就绪（$CONFIG_JSON 将由程序首次启动时生成）"
  return 0
}

# ── 进程身份 ────────────────────────────────────────────────────────────────
check_identity() {
  local pid="$1" exe want
  [ -r "/proc/$pid/exe" ] || return 1
  exe="$(resolve_path "$(readlink "/proc/$pid/exe" 2>/dev/null)")"
  want="$(resolve_path "$BIN")"
  [ -n "$exe" ] && [ "$exe" = "$want" ] || return 1
}

find_orphans() {
  local pid exe want
  want="$(resolve_path "$BIN")"
  for pid in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
    [ "$pid" = "$$" ] && continue
    [ -r "/proc/$pid/exe" ] || continue
    exe="$(resolve_path "$(readlink "/proc/$pid/exe" 2>/dev/null)")"
    [ "$exe" = "$want" ] && printf '%s\n' "$pid"
  done
}

wait_ready() {
  local pid="$1" waited=0 code
  while [ "$waited" -lt "$READY_TIMEOUT" ]; do
    if ! check_process "$pid"; then
      log_msg "进程在启动窗口内退出（见 $LOG_FILE）"
      return 1
    fi
    code="$(page_code)"
    if [ "$code" = "200" ]; then
      log_msg "就绪（${waited}s）：面板 http://$CFIP_LISTEN:$CFIP_PORT/（首页 $code）"
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  log_msg "等待 ${READY_TIMEOUT}s 仍未就绪（首页 ${code:-000}）"
  return 1
}

start_process() {
  local pid owner write_flag="-write"
  if [ -r "$PID_FILE" ]; then
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if check_process "$pid" && check_identity "$pid"; then
      log_msg "已在运行（pid=$pid），跳过启动"
      return 0
    fi
    rm -f "$PID_FILE"
  fi

  load_config
  rotate_logs
  ensure_config_json

  [ -x "$BIN" ] || { log_msg "找不到可执行文件 $BIN（payload 缺失？）"; return 1; }
  [ "$CFIP_WRITE" = "1" ] || write_flag="-write=false"

  if port_in_use "$CFIP_PORT"; then
    owner="$(port_owner "$CFIP_PORT")"
    if [ -n "$owner" ]; then
      log_msg "警告：端口 $CFIP_PORT 已被占用（$owner），若启动失败请改端口或先停掉占用者"
    fi
  fi

  log_msg "启动：cloudflareip -listen $CFIP_LISTEN:$CFIP_PORT（写 hosts=$([ "$CFIP_WRITE" = 1 ] && echo 允许 || echo 预览)，工作目录 $PKGVAR）"
  # NO_BROWSER：服务里绝不能尝试 xdg-open；HOME 指到 PKGVAR，任何 ~ 展开都不会跑出应用目录。
  ( cd "$PKGVAR" && HOME="$PKGVAR/home" NO_BROWSER=1 \
      "$BIN" -config "$CONFIG_JSON" -listen "$CFIP_LISTEN:$CFIP_PORT" "$write_flag" ) \
    >> "$LOG_FILE" 2>&1 &
  pid=$!
  printf '%s' "$pid" > "$PID_FILE"

  if wait_ready "$pid"; then
    return 0
  fi

  log_msg "启动失败，回收本次拉起的进程"
  kill -TERM "$pid" 2>/dev/null
  sleep 2
  check_process "$pid" && kill -KILL "$pid" 2>/dev/null
  local opid
  for opid in $(find_orphans); do kill -TERM "$opid" 2>/dev/null; done
  rm -f "$PID_FILE"
  return 1
}

stop_process() {
  local pid waited=0 opid
  if [ -r "$PID_FILE" ]; then
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if check_process "$pid" && check_identity "$pid"; then
      log_msg "停止 pid=$pid"
      kill -TERM "$pid" 2>/dev/null
      while [ "$waited" -lt 15 ] && check_process "$pid"; do sleep 1; waited=$((waited + 1)); done
      if check_process "$pid"; then
        log_msg "SIGTERM 超时，SIGKILL pid=$pid"
        kill -KILL "$pid" 2>/dev/null
        sleep 1
      fi
    else
      log_msg "pid 文件指向的进程不存在或身份不符（pid=${pid:-空}），跳过"
    fi
    rm -f "$PID_FILE"
  fi

  for opid in $(find_orphans); do
    log_msg "清理孤儿进程 pid=$opid"
    kill -TERM "$opid" 2>/dev/null
  done
  sleep 1
  for opid in $(find_orphans); do
    log_msg "孤儿进程未退出，SIGKILL pid=$opid"
    kill -KILL "$opid" 2>/dev/null
  done
  return 0
}

status_process() {
  local pid
  if [ -r "$PID_FILE" ]; then
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if check_process "$pid" && check_identity "$pid"; then return 0; fi
  fi
  for pid in $(find_orphans); do return 0; done
  return 3
}

# 安装期预检（install_callback 调用）：确认二进制与配置目录就位即可，不起服务。
bootstrap_process() {
  load_config
  mkdir -p "$CONFIG_DIR" "$PKGVAR/home" "$PKGVAR/tmp" 2>/dev/null || true
  [ -x "$BIN" ] || { echo "找不到可执行文件 $BIN" >&2; log_msg "引导失败：找不到 $BIN"; return 1; }
  ensure_config_json || return 1
  log_msg "安装期预检完成：端口 $CFIP_PORT，监听 $CFIP_LISTEN，写 hosts=$([ "$CFIP_WRITE" = 1 ] && echo 允许 || echo 预览)"
  return 0
}

case "${1:-}" in
  start)     start_process ;;
  stop)      stop_process ;;
  status)    status_process ;;
  bootstrap) bootstrap_process ;;
  *)         echo "usage: $0 {start|stop|status|bootstrap}"; exit 1 ;;
esac
