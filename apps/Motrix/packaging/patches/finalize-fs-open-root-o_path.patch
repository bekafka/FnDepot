+/// Directory flags shared by every component of the absolute root walk.
+const DIR_FLAGS: libc::c_int = libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC;
+
+/// Open one directory while walking the absolute root path.
+///
+/// A readable handle (`O_RDONLY`) stays the preferred result, so behaviour on
+/// ordinary filesystems is unchanged. Some NAS kernels, however, let an
+/// application user *traverse* a data-volume root without letting it *read*
+/// that directory: fnOS ships a `trimacl` layer that does exactly this, and
+/// `O_RDONLY | O_DIRECTORY` then fails with `EACCES` even though the
+/// application owns the download directory further down the path. Retrying
+/// such a component with `O_PATH` keeps the walk working — `O_PATH`
+/// descriptors are accepted by `openat`, `renameat2`, `linkat`, `statx` and
+/// friends, which is all the publication path needs.
+///
+/// The final component is reopened read-only through the held descriptor when
+/// that is possible, because later steps (root identity checks, directory
+/// flushes) prefer a genuinely readable handle. An unreadable final directory
+/// degrades to the `O_PATH` handle instead of failing the whole operation.
+fn open_dir_component(parent: RawFd, name: &CStr, is_last: bool) -> io::Result<OwnedFd> {
+    let readable = unsafe { libc::openat(parent, name.as_ptr(), libc::O_RDONLY | DIR_FLAGS) };
+    if readable >= 0 {
+        return Ok(unsafe { OwnedFd::from_raw_fd(readable) });
+    }
+    let error = io::Error::last_os_error();
+    if !matches!(error.raw_os_error(), Some(libc::EACCES) | Some(libc::EPERM)) {
+        return Err(error);
+    }
+    let path_only = unsafe { libc::openat(parent, name.as_ptr(), libc::O_PATH | DIR_FLAGS) };
+    if path_only < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let handle = unsafe { OwnedFd::from_raw_fd(path_only) };
+    if !is_last {
+        return Ok(handle);
+    }
+    let reopened =
+        unsafe { libc::openat(handle.as_raw_fd(), c".".as_ptr(), libc::O_RDONLY | DIR_FLAGS) };
+    if reopened >= 0 {
+        return Ok(unsafe { OwnedFd::from_raw_fd(reopened) });
+    }
+    Ok(handle)
+}
