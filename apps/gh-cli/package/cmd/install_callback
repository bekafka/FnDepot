#!/bin/bash
# ==============================================================================
# 安装后：建立 gh 命令入口、自证二进制能跑、处理向导里的 GitHub Token。
#
# Token 的两份落点（有意为之）：
#   · $PKGVAR/github-token          0600，规范来源，重装/升级后仍在
#   · $APPDEST/etc/github-token     0640 + ACL 授予设备普通用户组（默认 Users）读，
#                                   供该组成员通过 bin/gh 包装层自动注入 GH_TOKEN
# 即「普通用户组可用、组外账号不可读」。更严可把 GH_FNOS_TOKEN_GROUP 指到专用组，
# 或干脆删掉副本（其它用户各自 gh auth login）。
# ==============================================================================
set -u

APPNAME="gh-cli"
PKGVAR="${TRIM_PKGVAR:?}"
APPDEST="${TRIM_APPDEST:?}"
LOG="$PKGVAR/info.log"
TMPLOG="${TRIM_TEMP_LOGFILE:-}"
WRAPPER="$APPDEST/bin/gh"
REAL="$APPDEST/bin/gh.real"
HELPER="$APPDEST/gh-link.sh"
TOKEN_FILE="$PKGVAR/github-token"
TOKEN_MIRROR_DIR="$APPDEST/etc"
TOKEN_MIRROR="$TOKEN_MIRROR_DIR/github-token"

emit() {
  printf '%s - [install] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG" 2>/dev/null || true
  [ -n "$TMPLOG" ] && printf '[install] %s\n' "$*" >> "$TMPLOG" 2>/dev/null || true
  echo "[install] $*"
}

mkdir -p "$PKGVAR" 2>/dev/null || true

# ── 1. 可执行文件自检 ───────────────────────────────────────────────────────
if [ ! -f "$REAL" ] || [ ! -f "$WRAPPER" ]; then
  emit "payload 不完整（缺 bin/gh 或 bin/gh.real），安装失败"
  [ -n "$TMPLOG" ] && echo "安装包不完整：缺少 gh 可执行文件" >> "$TMPLOG"
  exit 1
fi
chmod 0755 "$REAL" "$WRAPPER" 2>/dev/null || true
[ -f "$HELPER" ] && chmod 0755 "$HELPER" 2>/dev/null || true

if ! VER="$(timeout 30 "$REAL" --version 2>>"$LOG" | head -n 1)"; then
  emit "gh 无法运行（架构或运行时库不匹配），安装失败"
  [ -n "$TMPLOG" ] && echo "gh 无法在本机运行，请确认安装包架构与设备一致（arm 包 vs x86 包）" >> "$TMPLOG"
  exit 1
fi
emit "gh 二进制自检通过：$VER"

# ── 2. GitHub Token（可选）──────────────────────────────────────────────────
TOKEN="$(printf '%s' "${wizard_github_token:-}" | tr -d '\r' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"

if [ -z "$TOKEN" ]; then
  emit "未填写 GitHub Token（可选）：gh 命令照常可用，需要认证时请各自执行 gh auth login，或设置 GH_TOKEN"
else
  case "$TOKEN" in
    *[[:space:]]*)
      emit "Token 含空白字符，已忽略（未写入）。如需认证请重装并填写正确的 token"
      TOKEN=""
      ;;
  esac
  if [ -n "$TOKEN" ] && [ "${#TOKEN}" -lt 20 ]; then
    emit "Token 长度异常（${#TOKEN} 位），已忽略（未写入）。请确认复制完整"
    TOKEN=""
  fi
fi

if [ -n "$TOKEN" ]; then
  # 规范来源：仅应用账号可读
  ( umask 077; printf '%s\n' "$TOKEN" > "$TOKEN_FILE" ) 2>>"$LOG" || emit "写入 $TOKEN_FILE 失败（继续）"
  chmod 600 "$TOKEN_FILE" 2>/dev/null || true

  # 终端可读副本：让 bin/gh 包装层能为「普通用户组」成员注入 GH_TOKEN。
  # 可见范围收紧：0640 + 属组 = 设备普通用户组（默认 Users），不再是 0644 的
  # 「任何账号可读」；不在该组的账号读不到，需要时各自 gh auth login。
  # 可用 GH_FNOS_TOKEN_GROUP 指定别的组；该组不存在时降级为 0600（仅应用账号）。
  TOKEN_GROUP="${GH_FNOS_TOKEN_GROUP:-Users}"
  if mkdir -p "$TOKEN_MIRROR_DIR" 2>>"$LOG" \
     && ( umask 077; printf '%s\n' "$TOKEN" > "$TOKEN_MIRROR" ) 2>>"$LOG"; then
    chmod 0600 "$TOKEN_MIRROR" 2>/dev/null || true
    # 注意：本脚本以包用户身份运行，chgrp 到「自己不属于的组」会被拒（EPERM），
    # 所以主路径是用 ACL 授予目标组读（属主可以给任意组加 ACL），
    # 再用 chmod 0640 把 ACL mask 抬到 r--（否则 mask 为 --- 时授权不生效）。
    if getent group "$TOKEN_GROUP" >/dev/null 2>&1; then
      if setfacl -m "g:${TOKEN_GROUP}:r--" "$TOKEN_MIRROR" 2>>"$LOG" \
         && chmod 0640 "$TOKEN_MIRROR" 2>>"$LOG"; then
        emit "已写入终端 token 副本：$TOKEN_MIRROR（0640 + ACL 授予组 ${TOKEN_GROUP} 读，组外账号不可读）"
      elif chgrp "$TOKEN_GROUP" "$TOKEN_MIRROR" 2>>"$LOG" \
           && chmod 0640 "$TOKEN_MIRROR" 2>>"$LOG"; then
        emit "已写入终端 token 副本：$TOKEN_MIRROR（0640，属组 ${TOKEN_GROUP}，仅该组成员可读）"
      else
        chmod 0600 "$TOKEN_MIRROR" 2>/dev/null || true
        emit "无法把 token 副本授权给组 ${TOKEN_GROUP}（ACL/chgrp 都失败）：已设为 0600，其它用户需各自 gh auth login"
      fi
    else
      emit "设备上不存在用户组 ${TOKEN_GROUP}：token 副本设为 0600（仅应用账号可读），其它用户需各自 gh auth login；可用 GH_FNOS_TOKEN_GROUP 指定组名后重装"
    fi
  else
    emit "写入终端副本失败（$TOKEN_MIRROR）：命令行用户将拿不到自动注入的 GH_TOKEN"
  fi

  # 验证（网络不通或 token 权限不足都只告警，不阻断安装）
  WHO="$(GH_TOKEN="$TOKEN" timeout 25 "$REAL" api user --jq .login 2>>"$LOG" | tr -d '\r\n')"
  if [ -n "$WHO" ]; then
    emit "GitHub Token 验证通过：已认证为 @$WHO"
  else
    LASTERR="$(tail -n 1 "$LOG" 2>/dev/null | cut -c1-160)"
    emit "GitHub Token 未能验证（不阻断安装）：可能是外网不通或 token 无 user 读取权限；错误摘要：${LASTERR:-无}"
  fi
fi

# ── 3. 命令入口 ─────────────────────────────────────────────────────────────
if [ -f "$HELPER" ]; then
  bash "$HELPER" ensure >> "$LOG" 2>&1 || true
  if [ -L /usr/local/bin/gh ] && \
     [ "$(readlink -f /usr/local/bin/gh)" = "$(readlink -f "$WRAPPER")" ]; then
    emit "命令入口就绪：/usr/local/bin/gh → $WRAPPER（内含 token 注入包装）"
  else
    emit "命令入口尚未出现（当前身份 $(id -un) 无 /usr/local/bin 写权限）；manifest 已声明 usr-local-linker，平台会在安装收尾/启动时建立"
  fi
else
  emit "缺少 $HELPER，跳过命令入口（可执行文件在 $WRAPPER）"
fi

emit "用法：gh --version / gh auth status / gh repo list / gh pr list / gh api user"
emit "提示：本包只提供 gh 命令；仓库操作仍受 GitHub 侧权限约束，建议使用最小权限 token"
exit 0
