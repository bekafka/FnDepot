#!/bin/bash
# ==============================================================================
# 卸载后：撤掉本应用建立的命令入口，并还原安装时接管掉的那份同名命令。
#
# 为什么不直接调 payload 里的 pnpm-link.sh：
#   uninstall_callback 执行时应用目录可能已被清掉，helper 不保证还在。
#   所以这里的清理逻辑是自带的（与 pnpm-link.sh 的记录格式一致），不依赖 payload。
#
# 路径护栏：
#   · 只删「指向本应用」的链接（/var/apps/pnpm/... 或 /vol1/@appcenter/pnpm/...）；
#   · 记录文件只在 /vol1/@appdata/* 下才做删除，避免 PKGVAR 被污染时误删；
#   · 还原目标不存在就只清理，不制造悬空链接。
# ==============================================================================
set -u

APPNAME="pnpm"
PKGVAR="${TRIM_PKGVAR:-}"
LINK="/usr/local/bin/pnpm"
RECORD="${PKGVAR:+$PKGVAR/preserved-usr-local-bin-pnpm}"
MODE="${wizard_uninstall_mode:-keep}"

log() {
  printf '%s - [uninstall] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" \
    >> "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true
  echo "[uninstall] $1"
}

# ── 1. 移除本应用建立的命令入口 ─────────────────────────────────────────────
if [ -L "$LINK" ]; then
  TARGET="$(readlink "$LINK" 2>/dev/null || true)"
  case "$TARGET" in
    /var/apps/$APPNAME/*|/vol1/@appcenter/$APPNAME/*)
      rm -f "$LINK" 2>/dev/null && log "已移除命令入口 $LINK（原指向 $TARGET）"
      ;;
    *)
      log "$LINK 指向别处（$TARGET），不属于本应用，不动它"
      ;;
  esac
elif [ -e "$LINK" ]; then
  log "$LINK 是真实文件，不属于本应用，不动它"
else
  log "$LINK 不存在，无需移除"
fi

# ── 2. 还原安装时被接管的同名命令 ───────────────────────────────────────────
if [ -n "$RECORD" ] && [ -s "$RECORD" ]; then
  PREV="$(head -n 1 "$RECORD" | tr -d '\r\n' | sed 's/[[:space:]]*$//')"
  if [ -n "$PREV" ] && { [ -e "$PREV" ] || [ -L "$PREV" ]; }; then
    if [ ! -e "$LINK" ] && [ ! -L "$LINK" ]; then
      ln -sfn "$PREV" "$LINK" 2>/dev/null && log "已还原被接管的命令入口：$LINK → $PREV"
    else
      log "还原跳过：$LINK 已被别的东西占用（记录的原指向是 $PREV）"
    fi
  else
    log "安装时接管的原命令已不存在（${PREV:-空}），不做还原以免留下悬空链接"
  fi
else
  log "没有接管记录（安装时 /usr/local/bin/pnpm 本来就不存在），无需还原"
fi

# ── 3. 按用户选择处理应用状态目录 ───────────────────────────────────────────
case "$MODE" in
  purge)
    case "$PKGVAR" in
      /vol1/@appdata/*)
        log "完全卸载：删除还原记录与安装日志"
        rm -f "$PKGVAR/preserved-usr-local-bin-pnpm" \
              "$PKGVAR/preserved-usr-local-bin-pnpm.bin" \
              "$PKGVAR/info.log.1" 2>/dev/null || true
        log "残留内容：$(ls -A "$PKGVAR" 2>/dev/null | tr '\n' ' ')"
        rm -f "$PKGVAR/info.log" 2>/dev/null || true
        ;;
      *)
        log "PKGVAR 不在预期路径（${PKGVAR:-空}），为安全起见跳过删除"
        ;;
    esac
    ;;
  *)
    log "保留记录卸载：还原记录与日志都留着，重装后会重新建立命令入口"
    ;;
esac

log "提示：你的项目目录与 pnpm 的全局缓存（在各自用户家目录）都未改动"
exit 0
