#!/bin/bash
# 应用设置页提交后：重新落配置；只有在跑着的时候才重启（用户主动停掉的不许偷偷拉起）。
set -u
APPNAME="Magpie"
PKGVAR="${TRIM_PKGVAR:?}"
APPDEST="${TRIM_APPDEST:?}"
MAIN="${MAGPIE_MAIN:-/var/apps/$APPNAME/cmd/main}"
LOG="$PKGVAR/info.log"
OLD_CONF_HASH="$(sha256sum "$PKGVAR/config.env" 2>/dev/null | awk '{print $1}')"
OLD_LAN="$(sed -n 's/^MAGPIE_LAN=//p' "$PKGVAR/config.env" 2>/dev/null | tail -n 1)"

log() { printf '%s - [config] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG" 2>/dev/null || true; }

was_running=0
if [ -x "$MAIN" ] && "$MAIN" status >/dev/null 2>&1; then
  was_running=1
fi

bash "$APPDEST/apply-config.sh" config || { log "apply-config 失败，配置未生效"; exit 1; }

NEW_CONF_HASH="$(sha256sum "$PKGVAR/config.env" 2>/dev/null | awk '{print $1}')"
NEW_LAN="$(sed -n 's/^MAGPIE_LAN=//p' "$PKGVAR/config.env" 2>/dev/null | tail -n 1)"
log "配置已更新（端口文件 $([ "$OLD_CONF_HASH" = "$NEW_CONF_HASH" ] && echo 未变 || echo 已变)，局域网共享 $([ "$OLD_LAN" = "$NEW_LAN" ] && echo 未变 || echo 已变)）"

if [ "$was_running" = "1" ]; then
  if [ "$OLD_CONF_HASH" != "$NEW_CONF_HASH" ] || [ "$OLD_LAN" != "$NEW_LAN" ]; then
    log "重启服务以应用新配置"
    "$MAIN" stop >/dev/null 2>&1 || true
    "$MAIN" start >/dev/null 2>&1 || log "重启失败，请查看 $LOG"
  else
    log "配置无变化，不重启"
  fi
fi
exit 0
